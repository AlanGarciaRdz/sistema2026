{
  "name": "transportation-backend",
  "version": "1.0.0",
  "description": "Backend API for Transportation Management System",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "deploy:db": "rsync -avz ./db/transportation_db.dump rk:/opt/servicios/sistema/db/",
    "deploy:backend": "rsync -avz --exclude='db' --exclude='node_modules' --exclude='.env' ./ rk:/opt/servicios/sistema"
  },
  "dependencies": {
    "axios": "^1.13.4",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.3"
  }
}
